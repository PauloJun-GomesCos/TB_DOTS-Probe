{
  "id": "suite-1786016770572",
  "name": "Test pcap sending (config HOOC)",
  "description": "Test the pcap sending command by configuring the HOOC devices to enable or disable routing between the LAN and SEP0 networks. A ping is then sent from the LAN to SEP0 to verify that the routing configuration is correct.",
  "environment": {
    "LAN": {
      "probe_id": "probe-6a1a9c",
      "interface": "eth1"
    }
  },
  "variables": {
    "Addr_LAN_eth1": "192.168.2.198",
    "Addr_SEP0_eth1": "192.168.3.130"
  },
  "tree": {
    "type": "seq",
    "children": [
      {
        "type": "command",
        "command": {
          "id": "ping-551441c4",
          "probe_label": "LAN",
          "action": "ping",
          "action_label": "Ping",
          "params": {
            "interface": "eth1",
            "target": "${Addr_SEP0_eth1}",
            "count": 4,
            "timeout_ms": 1000
          },
          "expected": [
            {
              "type_match": "equal",
              "values": {
                "packet_loss_percent": 0
              }
            }
          ],
          "timeout": 6
        }
      },
