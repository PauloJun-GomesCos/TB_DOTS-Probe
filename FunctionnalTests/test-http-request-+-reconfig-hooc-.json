{
  "id": "suite-1786003126339",
  "name": "Test HTTP request + Reconfig HOOC ",
  "description": "Configuring the HOOC config by sending http request with a config file. We activate/desactivate the root LAN -> SEP0 and test the config with ping command. Everything is captured.",
  "environment": {
    "Bridge": {
      "probe_id": "probe-eeedb8",
      "interface": "br0"
    },
    "LAN": {
      "probe_id": "probe-6a1a9c",
      "interface": "eth1"
    }
  },
  "variables": {
    "Addr_SEP0_eth1": "192.168.3.130"
  },
  "tree": {
    "type": "seq",
    "children": [
      {
        "type": "command",
        "command": {
          "id": "capture-5177f820",
          "probe_label": "Bridge",
          "action": "capture",
          "action_label": "Capture",
          "params": {
            "interface": "br0",
            "filter": "ip",
            "timeout_s": 30
          },
          "timeout": 35
        }
      },
      {
        "type": "command",
        "command": {
          "id": "ping-401aba0f",
          "probe_label": "LAN",
          "action": "ping",
          "action_label": "Ping",
          "params": {
            "interface": "eth1",
            "target": "${Addr_SEP0_eth1}",
            "count": 4,
            "timeout_ms": 1000
          },
          "expected": [
            {
              "type_match": "equal",
              "values": {
                "packet_loss_percent": 0
              }
            }
          ],
          "timeout": 6
        }
      },
      {
        "type": "command",
        "command": {
          "id": "http-7f019fde",
          "probe_label": "LAN",
          "action": "http",
          "action_label": "HTTP Request",
          "params": {
            "interface": "eth1",
            "method": "POST",
            "header": {
              "Content-Type": "application/octet-stream"
            },
            "url": "http://192.168.2.1/api/config/import?password=1234",
            "body": {
              "data": "",
              "name": "WithoutRooting.bin",
              "type": "file"
            }
          },
          "timeout": 15
        }
      },
      {
        "type": "command",
        "command": {
          "id": "pause-7466d7de",
          "action": "pause",
          "action_label": "Pause",
          "params": {
            "seconds": 5
          },
          "timeout": 310
        }
      },
      {
        "type": "command",
        "command": {
          "id": "ping-442aab0a",
          "probe_label": "LAN",
          "action": "ping",
          "action_label": "Ping",
          "params": {
            "interface": "eth1",
            "target": "${Addr_SEP0_eth1}",
            "count": 4,
            "timeout_ms": 1000
          },
          "expected": [
            {
              "type_match": "equal",
              "values": {
                "packet_loss_percent": 100
              }
            }
          ],
          "timeout": 6
        }
      },
      {
        "type": "command",
        "command": {
          "id": "http-ea62227b",
          "probe_label": "LAN",
          "action": "http",
          "action_label": "HTTP Request",
          "params": {
            "interface": "eth1",
            "method": "POST",
            "header": {
              "Content-Type": "application/octet-stream"
            },
            "url": "http://192.168.2.1/api/config/import?password=1234",
            "body": {
              "data": "",
              "name": "WithRooting.bin",
              "type": "file"
            }
          },
          "timeout": 15
        }
      },
      {
        "type": "command",
        "command": {
          "id": "pause-164128ef",
          "action": "pause",
          "action_label": "Pause",
          "params": {
            "seconds": 5
          },
          "timeout": 310
        }
      },
      {
        "type": "command",
        "command": {
          "id": "ping-69128b17",
          "probe_label": "LAN",
          "action": "ping",
          "action_label": "Ping",
          "params": {
            "interface": "eth1",
            "target": "${Addr_SEP0_eth1}",
            "count": 4,
            "timeout_ms": 1000
          },
          "expected": [
            {
              "type_match": "equal",
              "values": {
                "packet_loss_percent": 0
              }
            }
          ],
          "timeout": 6
        }
      }
    ]
  }
}